<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>io.phinfotech.gitlab-milestones-and-issues</id>
    <name>GitLab Milestones and Issues UI</name>
    <vendor email="jani@phinfotech.io" url="https://phinfotech.io">PH InfoTech</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="GitLab"
                    icon="/icons/gitlab.svg"
                    anchor="right"
                    factor="first"
                    implementation="io.phinfotech.gitlab.ui.GitLabToolWindowFactory"/>

        <applicationConfigurable parentId="tools"
                                 instance="io.phinfotech.gitlab.settings.GitLabSettingsConfigurable"
                                 id="io.phinfotech.gitlab.settings.GitLabSettings"
                                 displayName="GitLab"/>

        <applicationService serviceImplementation="io.phinfotech.gitlab.settings.GitLabSettings"/>
    </extensions>

    <actions>
        <action id="io.phinfotech.gitlab.actions.RefreshGitLab"
                class="io.phinfotech.gitlab.actions.RefreshAction"
                text="Refresh GitLab"
                description="Refresh GitLab data">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default"
                              first-keystroke="control R"/>
        </action>
    </actions>
</idea-plugin>
